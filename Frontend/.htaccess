# .htaccess - Apache Server Configuration for SEO & Performance
# Place this in your root directory for Apache servers

# ============================================
# 1. ENABLE GZIP COMPRESSION
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/svg+xml
</IfModule>

# ============================================
# 2. BROWSER CACHING
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Default
  ExpiresDefault "access plus 2 days"
  
  # HTML files (checked frequently)
  ExpiresByType text/html "access plus 1 hour"
  
  # CSS and JS (cached longer)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  
  # Images (cached very long)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  
  # Fonts
  ExpiresByType font/truetype "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  ExpiresByType application/x-font-woff2 "access plus 1 year"
  
  # XML
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

# ============================================
# 3. ENABLE HTTP/2 SERVER PUSH
# ============================================
<IfModule mod_http2.c>
  Protocols h2 http/1.1
</IfModule>

# ============================================
# 4. SECURITY HEADERS
# ============================================
<IfModule mod_headers.c>
  # Prevent content type sniffing
  Header always set X-Content-Type-Options "nosniff"
  
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # XSS Protection
  Header always set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Feature Policy / Permissions Policy
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================
# 5. ETAG FOR CACHING
# ============================================
<IfModule mod_headers.c>
  Header unset ETag
  FileETag None
</IfModule>

# ============================================
# 6. URL REWRITING (IMPORTANT FOR SPA)
# ============================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Remove www. (optional - choose one)
  # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  # RewriteRule ^(.*)$ http://%1/$1 [R=301,L]
  
  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Route all requests to index.html for SPA
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
  
  # Don't rewrite robots.txt and sitemap.xml
  RewriteRule ^(robots\.txt|sitemap\.xml|\.well-known/.*)$ - [L]
</IfModule>

# ============================================
# 7. DISABLE DIRECTORY LISTING
# ============================================
Options -Indexes

# ============================================
# 8. CUSTOM ERROR PAGES (Optional)
# ============================================
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

# ============================================
# 9. MIME TYPES FOR WEB FONTS
# ============================================
<IfModule mod_mime.c>
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType font/x-woff .woff
  AddType font/x-woff2 .woff2
  AddType application/font-woff .woff
  AddEncoding gzip .woff2
</IfModule>

# ============================================
# 10. REMOVE SERVER SIGNATURE
# ============================================
ServerSignature Off

# ============================================
# 11. BLOCK BAD BOTS
# ============================================
<IfModule mod_setenvif.c>
  SetEnvIfNoCase User-Agent ".*AhrefsBot.*" bad_bot
  SetEnvIfNoCase User-Agent ".*MJ12bot.*" bad_bot
  SetEnvIfNoCase User-Agent ".*SemrushBot.*" bad_bot
  SetEnvIfNoCase User-Agent ".*DotBot.*" bad_bot
  
  <RequireAll>
    Require all granted
    Require not env bad_bot
  </RequireAll>
</IfModule>

# ============================================
# 12. DISABLE HOTLINKING (Protect Images)
# ============================================
<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
  SetEnvIf Referer "^https?://annek\.com" local_ref=1
  SetEnvIf Referer "^$" local_ref=1
  
  <RequireAll>
    Require env local_ref
    Require all granted
  </RequireAll>
</FilesMatch>
