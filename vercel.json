{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --prefix Frontend && npm install --prefix Backend",
  "buildCommand": "npm run build --prefix Frontend",
  "outputDirectory": "Frontend/dist",
  "headers": [
    {
      "source": "/api/:path(portfolio|stats|feedback|settings)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/intro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "annek.vercel.app"
        }
      ],
      "destination": "https://annek.tech/$1",
      "permanent": true
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "annek-d6zv-a-g-prakash-leenas-projects.vercel.app"
        }
      ],
      "destination": "https://annek.tech/$1",
      "permanent": true
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "annek-d6zv-git-main-a-g-prakash-leenas-projects.vercel.app"
        }
      ],
      "destination": "https://annek.tech/$1",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/services",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app.html"
    }
  ]
}
