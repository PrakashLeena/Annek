{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(portfolio|stats|feedback|settings)$",
      "dest": "server.js",
      "headers": {
        "Cache-Control": "public, max-age=300"
      }
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
