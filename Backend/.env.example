# ── Server ──
PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/annek

# ── Frontend CORS (comma-separated) ──
FRONTEND_URL=http://localhost:5173,https://www.annek.tech

# ── Admin ──
ADMIN_SECRET=your-long-random-secret-here

# ── AI Website Builder (NVIDIA GLM-5.2) ──
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Firebase Admin (optional — for verifying user tokens on save) ──
# Paste the full service account JSON as a single line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Email / Cloudinary (existing) ──
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# EMAIL_USER=
# EMAIL_PASS=
