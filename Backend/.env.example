# ── Server ──
PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/annek

# ── Frontend CORS (comma-separated) ──
FRONTEND_URL=http://localhost:5173,https://www.annek.tech

# ── Admin ──
# Google accounts allowed into /admin (the server verifies their Firebase sign-in).
# In the merged Vercel project the existing VITE_ADMIN_EMAILS / VITE_FIREBASE_PROJECT_ID are used if these are unset.
ADMIN_EMAILS=you@gmail.com
FIREBASE_PROJECT_ID=your_project_id
ADMIN_SECRET=your-long-random-secret-here

# ── Firebase Admin (optional) ──
# Paste the full service account JSON as a single line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Email / Cloudinary (existing) ──
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# EMAIL_USER=
# EMAIL_PASS=
